# Système et éditeurs
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.idea/
.vscode/
*.log

# Les fichiers qui FONT les defis des machines ne sont pas des dechets : ils
# sont le contenu pedagogique (un journal a analyser, une cle a examiner).
# Sans ces deux lignes, six fichiers du dojo manquaient a l'image construite
# en CI alors qu'ils existaient en local — et neuf defis devenaient
# inresolvables. Trouve par le workflow Machines, pas a la main.
!labs/*/machine/**/*.log

# Secrets et credentials — ne jamais versionner
.env
.env.*
!.env.example
*.pem
# ... sauf dans les machines, ou la cle EST le sujet du defi.
!labs/*/machine/**/*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json
.netrc
.npmrc

# Dépendances et artefacts de build
node_modules/
vendor/
dist/
build/
coverage/
out/
target/
*.zip

# WordPress
wp-config.php
wp-config-*.php
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
wp-content/backups/
*.sql
*.sql.gz
*.sql.zip
wp-admin/
wp-includes/

# Outillage local
.phpunit.result.cache
.php-cs-fixer.cache
phpunit.xml.bak

# Artefacts de laboratoire — fichiers créés par les conteneurs des élèves
# pendant les recettes (ils ne doivent jamais être versionnés)
labs/**/oom
labs/**/flag.txt
labs/**/.seca*

# Python
__pycache__/
*.pyc

# Artefacts produits par les outils de recolte : sources seulement, pas leurs sorties
tools/lots/cleaned/
tools/lots/recovered/
tools/lots-origine-sauvegarde/

